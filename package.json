{
  "name": "dream-admin",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: workspace-scoped long-term memory with an editable management page and an optional memory dream (distillation) loop driven by a model you choose.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "assets",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leopan0/DreamAdmin.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "memory",
    "long-term-memory",
    "memory-dream",
    "workspace"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true });\"",
    "build:js": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build": "npm run clean && npm run build:js && npm run build:client && npm run build:types",
    "bundle": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "gates": "node scripts/gates/run.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
